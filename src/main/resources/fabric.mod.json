{
  "schemaVersion": 1,
  "id": "theultimatecompatmod",
  "version": "${version}",

  "name": "The Ultimate Compat Mod",
  "description": "The Ultimate Compat Mod. The sole purpose is to fix those compat issues with all of these big mods. Now you can have them work together cohesively!",
  "authors": [
    "CozyStudios"
  ],
  "license": "CC0-1.0",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.cozystudios.theultimatecompatmod.TheUltimateCompatMod"
    ],
    "client": [
      "net.cozystudios.theultimatecompatmod.TheUltimateCompatModClient"
    ],
    "jei_mod_plugin": [
      "net.cozystudios.theultimatecompatmod.compat.jei.TheUltimateCompatModJEIPlugin"
    ]
  },

  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": "*",
    "minecraft": ">=1.20.1",
    "java": ">=17",
    "farmersdelight": "*",
    "farm_and_charm": "*"
  },
  "recommends": {
    "candlelight": "*",
    "jei": "*"
  }
}
